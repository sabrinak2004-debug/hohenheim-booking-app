generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL is no longer supported in schema files.
  // Move your connection URL for Migrate to prisma.config.ts and pass
  // either `adapter` for a direct database connection or `accelerateUrl`
  // for Accelerate to the PrismaClient constructor.
  // See: https://pris.ly/d/config-datasource and https://pris.ly/d/prisma7-client-config
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id           String   @id(map: "booking_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id      String   @db.Uuid
  user_id      String   @db.Uuid
  date         DateTime @db.Date
  starts_at    DateTime @db.Time(6)
  ends_at      DateTime @db.Time(6)
  people_count Int
  purpose      String?
  status       String   @default("confirmed")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  rooms        rooms    @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model exceptions {
  id        Int       @id(map: "exceptions_pkey") @default(autoincrement())
  date      DateTime  @unique(map: "exceptions_date_key") @db.Date
  opens     DateTime? @db.Time(6)
  closes    DateTime? @db.Time(6)
  is_closed Boolean   @default(true)
  reason    String?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model opening_hours {
  weekday   Int      @id
  opens     DateTime @db.Time(6)
  closes    DateTime @db.Time(6)
  is_closed Boolean  @default(false)
  note      String?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model rooms {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique
  capacity    Int
  description String
  features    String[]   @default([])
  photo_url   String?
  is_active   Boolean    @default(true)
  location    String
  bookings    bookings[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uni_email     String     @unique
  password_hash String
  role          String
  display_name  String
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  bookings      bookings[]
}
